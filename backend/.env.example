# Backend settings (app/core/config.py). Copy to backend/.env for running pytest/alembic on the host.
# Use 127.0.0.1, not localhost: compose binds IPv4 loopback only and localhost may resolve to ::1.
APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgresql://advolevel_app:advolevel_app@127.0.0.1:5442/advolevel
DATABASE_MIGRATION_URL=postgresql://advolevel:advolevel@127.0.0.1:5442/advolevel
REDIS_URL=redis://127.0.0.1:6390/0
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
DEBUG_ENDPOINTS_ENABLED=true

# Clerk (DEC-006). Issuer = Frontend API URL, e.g. https://<slug>.clerk.accounts.dev
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_AUTHORIZED_PARTIES=http://localhost:3000
AUTH_SECRET_KEY=
AUTH_WEBHOOK_SECRET=

# Email (OQ-029 pending): smtp -> Mailpit locally (inbox at http://127.0.0.1:8025), or console
EMAIL_PROVIDER=smtp
EMAIL_FROM=AdvoLevel <no-reply@advolevel.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Stub limits until plans exist (M11); -1 = unlimited
MAX_ORGS_PER_USER=-1
DEFAULT_SEATS_MAX=-1

# Observability (optional locally; SENTRY_DSN is required in production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
OTEL_SERVICE_NAME=advolevel-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATE=
