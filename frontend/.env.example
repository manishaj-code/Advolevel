# Copy to .env.local. NEXT_PUBLIC_* values are shipped to the browser: never put secrets in them.
# API origin only; generated client paths already include /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Clerk development instance (DEC-006): dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_RELEASE=
# Exposes /debug/sentry (MON-01 check). Never "true" in production.
NEXT_PUBLIC_DEBUG_ENDPOINTS=false

# Server-side only
SENTRY_DSN=
