# Read by docker compose (copy to .env). All optional; defaults shown.
# Host ports are offset from the usual defaults to avoid clashing with other local stacks.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6390
S3_HOST_PORT=8333
API_HOST_PORT=8000

MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Clerk development instance (dashboard → API keys / Webhooks). Issuer = Frontend API URL,
# e.g. https://<slug>.clerk.accounts.dev
AUTH_ISSUER=
AUTH_SECRET_KEY=
AUTH_WEBHOOK_SECRET=

# Leave empty locally unless you are verifying Sentry / tracing delivery.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
